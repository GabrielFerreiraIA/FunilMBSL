# =============================================================================
# VARIÁVEIS DE AMBIENTE
# Copie para .env.local (dev) ou configure no painel da Vercel (produção).
# NUNCA commite um arquivo .env com valores reais — o .gitignore já bloqueia
# .env e .env*.local por segurança.
# =============================================================================

# --- Pix -----------------------------------------------------------------
# Sem nenhuma variável abaixo configurada, o site roda em modo demonstração
# (QR de teste, sem cobrança real) — funciona pronto para uso.

# Ativa o Mercado Pago como provedor de Pix. Pegue o token de PRODUÇÃO em
# https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=

# Chave secreta do webhook (painel do MP: Suas integrações > sua aplicação >
# Webhooks). Sem ela o webhook ainda funciona, mas sem validar a assinatura.
MERCADOPAGO_WEBHOOK_SECRET=

# Segundos até o Pix expirar. O Mercado Pago exige entre 1800 (30 min) e
# 2592000 (30 dias) — valores menores que 1800 sobem automaticamente para 1800.
PIX_EXPIRACAO_SEGUNDOS=1800

# --- Domínio público -------------------------------------------------------
# Usado para montar a notification_url do webhook do Mercado Pago. Na Vercel
# é preenchido sozinho; fora dela, informe aqui (sem barra no final).
NEXT_PUBLIC_SITE_URL=

# --- Front-end -------------------------------------------------------------
# Espelha para o cliente se o Pix está em modo demonstração (só afeta textos
# de UI — a decisão de verdade é sempre no servidor, pela env var acima).
NEXT_PUBLIC_PIX_MODO_SIMULADO=true
